# Base URL of the arithmetic-calculator-api. Baked into the bundle at build time.
# `npm run build` FAILS unless this is set to an https:// URL — http is
# accepted only for loopback hosts (local builds). The app appends "api/v1",
# so the example below calls http://localhost:3001/api/v1/...
VITE_API_URL=http://localhost:3001/
# Production example:
# VITE_API_URL=https://arithmetic-calculator-api.onrender.com/
